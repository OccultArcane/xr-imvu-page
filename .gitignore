# a signed-in IMVU visitor's cookie header — a credential, never committed
# the session cookie now lives outside the project; this covers a stray copy
*.cookies

# a hand-set status label and other local scratch
assets/status.override.txt

# every product in the shop, as read at one moment: an input to a bulk pass,
# not something the page serves
assets/catalogue.json

# the webhook that gets told when the label changes — a credential, never committed
assets/notify.url

__pycache__/
*.pyc

# capture screenshots and preview pages kept at the project root, not part of the site
/*.png

# Freebuff project marker
.freebuff/
worker/.wrangler/
wrangler-dev.log
